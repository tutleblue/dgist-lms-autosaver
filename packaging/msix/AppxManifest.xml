<?xml version="1.0" encoding="utf-8"?>
<!--
  Daling Microsoft Store 판(MSIX) 매니페스트 틀.
  packaging\msix\build_msix.ps1 이 {{…}} 를 채워 묶음 폴더(build\msix\layout)에 넣는다. 직접 고치지 말고 이 틀을 고친다.

  - 이름·게시자: 이 PC 시험판은 사설 인증서(CN=붕어빵 (jykim5215), O=jykim5215)와 같은 값,
    Store 제출판(-Store)은 Partner Center '제품 ID' 화면의 Package/Identity/Name·Publisher 값으로 바꿔 묶는다.
  - runFullTrust: PyInstaller 로 묶은 보통 데스크톱 앱(Win32)이라 꼭 필요하다. 제출할 때 사유를 적는다 (FEATURES.md 'Microsoft Store 판').
  - 실행 파일 이름은 Daling.exe (작업 프로세스가 sys.executable 로 자기 자신을 다시 부른다).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Daling</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>DGIST LMS 강의자료, 과제 마감, 학교 메일을 한 화면에 모아 주는 앱</Description>
  </Properties>

  <Dependencies>
    <!-- 19041 = Windows 10 2004. 그 전 판은 AppData 쓰기를 모두 가상화해(복사 후 쓰기) 동작이 다르고, 지원도 끝났다 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Daling" Executable="Daling.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Daling"
        Description="DGIST LMS 강의자료, 과제 마감, 학교 메일을 한 화면에 모아 주는 앱"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Daling" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Windows 시작 시 자동 실행. Inno 설치판의 '시작 시 자동 실행'(기본 꺼짐)과 같게 꺼 둔다.
             MSIX 앱은 시작 프로그램 폴더에 바로 가기를 만들어도 그 파일이 앱 전용 AppData 로 가상화돼 탐색기가 못 본다.
             켜기: 설정 > 앱 > 시작 프로그램 (또는 작업 관리자 > 시작 앱) 에서 Daling -->
        <desktop:Extension Category="windows.startupTask" Executable="Daling.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DalingStartup" Enabled="false" DisplayName="Daling" />
        </desktop:Extension>
        <!-- 명령 줄 이름 daling.exe. 패키지 안의 실행 파일은 경로로 직접 켤 수 없어서, 설치본 점검
             (daling.exe autosaver-smoke 플래그)과 문제 신고 때 이 이름으로 부른다 -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Daling.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="daling.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
