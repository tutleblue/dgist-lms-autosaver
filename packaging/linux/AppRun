#!/bin/sh
# Daling AppImage 진입점 (.github/workflows/linux.yml 이 Daling.AppDir/AppRun 으로 넣는다)
# 묶은 실행 파일(PyInstaller 폴더 묶음)을 그대로 부른다. 인자(--autosaver-job·--autosaver-smoke)도 그대로 넘긴다.
# 작업 프로세스는 sys.executable(이 마운트 안의 daling)로 다시 띄우므로, 앱이 켜져 있는 동안은 마운트가 살아 있다.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/lib/daling/daling" "$@"
